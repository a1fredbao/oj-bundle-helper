{
  "name": "oj-bundle",
  "displayName": "oj-bundle",
  "description": "Bundle competitive programming C++ with syntax-aware compression.",
  "publisher": "alfred-bao",
  "version": "1.0.4",
  "packageManager": "bun@1.4.4",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/a1fredbao/oj-bundle-helper"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "oj-bundle.bundle-and-paste",
        "title": "oj-bundle: Bundle and paste"
      }
    ],
    "configuration": {
      "title": "oj-bundle",
      "properties": {
        "oj-bundle.executable": {
          "type": "string",
          "default": "oj-bundle",
          "description": "oj-bundle executable path."
        },
        "oj-bundle.args": {
          "type": "string",
          "default": "",
          "description": "Space-separated additional flags passed to oj-bundle. Example '-I path/to/your/library1 -I path/to/your/library2'."
        },
        "oj-bundle.shortenLocals": {
          "type": "boolean",
          "default": true,
          "description": "Use the C++ syntax tree to shorten safely resolved local variable names."
        }
      }
    },
    "keybindings": [
      {
        "command": "oj-bundle.bundle-and-paste",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "assets": "bun run scripts/prepare-assets.ts",
    "build": "bun run assets && bun run scripts/build.ts",
    "bump": "bun run scripts/bump-version.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "format": "biome format --write src scripts",
    "lint": "biome check src scripts",
    "package": "bun run build && vsce package",
    "test": "bun run assets && bun test src/test",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "bun run check && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "26.6.6",
    "@types/semver": "7.7.1",
    "@types/vscode": "1.98.0",
    "@vscode/vsce": "^4.1.1",
    "semver": "7.7.3",
    "tree-sitter-cpp": "0.23.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "string-argv": "0.4.0",
    "web-tree-sitter": "^0.27.2"
  }
}
